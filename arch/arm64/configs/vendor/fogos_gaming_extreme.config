###############################################################################
# FogOS Extreme Gaming Kernel — ULTRA Gaming Fragment
# Device: Motorola G45 / G34 (SM6375 / Holi)
# Developer: Prince (VirgoYT707) — Built Different
# Version: v2.0 Ultra
#
# Applied ON TOP OF fogos_gaming.config for maximum performance.
# Every option here pushes the SM6375 harder for BGMI / PUBG Mobile / FF.
###############################################################################

#
# BRANDING
#
CONFIG_LOCALVERSION="-FogOS-Extreme-Gaming-v2.0-Ultra"

###############################################################################
# CPU — Maximum Performance
###############################################################################

# Full PREEMPT (lowest latency wakeup, best for gaming)
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_NONE is not set

# WALT scheduler — tuned for big.LITTLE
CONFIG_SCHED_WALT=y
CONFIG_SCHED_CASS=y

# 300 Hz timer — sweet spot for gaming latency without battery kill
CONFIG_HZ_300=y
# CONFIG_HZ_250 is not set
# CONFIG_HZ_100 is not set

# High-res timers mandatory for sub-millisecond wakeups
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ=y
CONFIG_NO_HZ_COMMON=y

# IRQ time accounting (helps scheduler place work on right core)
CONFIG_IRQ_TIME_ACCOUNTING=y

# Avoid unnecessary kernel preemption delay
CONFIG_PREEMPT_COUNT=y

# CPU freq governors — default to performance
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y

# uclamp — pin foreground tasks to big cores
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=20

# SMP balancing
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y

# Boost on wakeup
CONFIG_BOOST_ON_WAKE=y

# SM6375 is 8-core
CONFIG_NR_CPUS=8

###############################################################################
# MEMORY — Zero-Stutter RAM Management
###############################################################################

# Android LMKD
CONFIG_ANDROID_LOW_MEMORY_KILLER=y

# Balance anon/file reclaim (prevents IO stutter during gaming)
CONFIG_BALANCE_ANON_FILE_RECLAIM=y

# Prioritize foreground OOM victim
CONFIG_PRIORITIZE_OOM_TASKS=y

# ZRAM with ZSTD — fastest compression
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_ZSMALLOC_STAT=y

# Transparent huge pages — big throughput for game engine
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set

# CMA — contiguous memory for camera/GPU
CONFIG_CMA=y

# SLUB fast path
CONFIG_SLUB=y
CONFIG_SLUB_CPU_PARTIAL=y

# Reduce fragmentation
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y

# Swap
CONFIG_SWAP=y

###############################################################################
# GPU — Adreno 619L Unlocked
###############################################################################

CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y
CONFIG_QCOM_KGSL=y

# Disable power collapse (GPU stays awake while gaming)
# CONFIG_QCOM_KGSL_IDLE_TIMEOUT is not set

###############################################################################
# NETWORK — Ultra Low Ping
###############################################################################

# TCP BBR — game-server optimized congestion control
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# FQ packet scheduler (pairs with BBR)
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# Increase socket buffer sizes
CONFIG_NET_VENDOR_QUALCOMM=y

# Packet timestamping for latency analysis
CONFIG_NETWORK_PHY_TIMESTAMPING=y

# DSCP QoS — marks game packets as high priority
CONFIG_NETFILTER_XT_MATCH_DSCP=y
CONFIG_NETFILTER_XT_TARGET_DSCP=y

# IPv6 (modern game servers use it)
CONFIG_IPV6=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_OPTIMISTIC_DAD=y

# Netfilter (VPN / hotspot support)
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# WireGuard (fast gaming VPN)
CONFIG_WIREGUARD=y

###############################################################################
# I/O — Storage Latency Zero
###############################################################################

CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_DEFAULT_IOSCHED="bfq"
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y

CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFSHCD_QTI=y

CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BLK_WBT=y

###############################################################################
# DISPLAY — 120 FPS Frame Scheduling
###############################################################################

# RT priority for SurfaceFlinger thread
CONFIG_RT_GROUP_SCHED=y
CONFIG_SCHED_AUTOGROUP=y

# Frame pacing
CONFIG_SYNC_FILE=y

###############################################################################
# CGROUPS — Android Gaming Process Pinning
###############################################################################

CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y

###############################################################################
# SECURITY — Keep SELinux (banking/auth apps work fine)
###############################################################################

CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
# CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE is not set

###############################################################################
# POWER — Smart Idle (save battery BETWEEN sessions)
###############################################################################

# Suspend/resume fast path
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND_SKIP_SYNC=y

# WLAN power save OFF during game (controlled by userspace WLAN driver)
# CONFIG_CFG80211_DEFAULT_PS is not set

# USB fast charge
CONFIG_QPNP_ADAPTIVE_CHARGE=m

###############################################################################
# CRYPTO — Fast Gaming VPN / HTTPS
###############################################################################

CONFIG_CRYPTO_CHACHA20=y
CONFIG_CRYPTO_POLY1305=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_ZSTD=y

###############################################################################
# DEBUG / OVERHEAD REDUCTION
###############################################################################

# Disable expensive tracing (reduces kernel overhead in games)
# CONFIG_FTRACE is not set
# CONFIG_TRACING is not set
# CONFIG_SCHEDSTATS is not set

# Remove verbose logging overhead
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_SLUB_DEBUG is not set

# Keep crash dumps (useful for debugging)
CONFIG_PANIC_TIMEOUT=5

###############################################################################
# COMPILER OPTIMIZATION
###############################################################################

# LTO — link-time optimization (smaller + faster kernel binary)
CONFIG_LTO_CLANG=y

# O3 optimization where safe
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set

###############################################################################
# INTERCONNECT — Holi Platform Bus Scaling
###############################################################################

CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_HOLI=y
CONFIG_INTERCONNECT_QCOM_CPUCP_L3=y
CONFIG_INTERCONNECT_QCOM_RPM=y
CONFIG_INTERCONNECT_QCOM_QOS=y

###############################################################################
# MODULES
###############################################################################

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
