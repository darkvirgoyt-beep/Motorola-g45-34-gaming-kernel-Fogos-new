###############################################################################
# FogOS runtime profile fragment — Motorola G45/G34 (fogos)
#
# Customization:
# 1. Performance Profile: responsive scheduling (WALT / performance / Kyber I/O)
# 2. Security: Rootless / CTS Clean (SELinux Enforcing, Play Integrity Verified)
# 3. Memory & Swapping: Zstandard (ZSTD) Adaptive 4GB/8GB Compression
###############################################################################

# Core FogOS runtime profile driver
CONFIG_FOGOS_PROFILE=y

# The Holi overlay declares compatible = "fpc,fpc1020". Build the matching
# driver into Image so fingerprint detection does not depend on Magisk.
CONFIG_INPUT_MISC_FPC1020=y

# ── Performance Governor & Tuning ──
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_SCHED_WALT=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y

# ── Low-Latency Gaming TCP / Networking ──
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBRPLUS=y
CONFIG_DEFAULT_BBRPLUS=y
CONFIG_DEFAULT_TCP_CONG="bbrplus"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y

# ── Zstandard (ZSTD) Adaptive RAM Compression ──
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_DEFLATE=y

# ── CTS Clean / Google Play Integrity & Enforcing Security ──
# KernelSU is disabled to maintain strict CTS / Play Integrity passing
# and vendor_dlkm ABI binary compatibility.
# CONFIG_KSU is not set
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y

# ── FogOS Max Frequency Lock & Thermal Bypass ──
# Force CPU governor to Performance globally
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_CONSERVATIVE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_INTERACTIVE is not set

# Kill Qualcomm Thermal Framework
CONFIG_QCOM_THERMAL=n
CONFIG_QTI_THERMAL_LIMITS=n
CONFIG_QTI_QMI_COOLING_DEVICE=n
CONFIG_QTI_CX_IPEAK_COOLING_DEVICE=n
CONFIG_CPU_THERMAL=n
CONFIG_DEVFREQ_THERMAL=n
CONFIG_THERMAL_GOV_STEP_WISE=n
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=n
CONFIG_THERMAL_GOV_USER_SPACE=n
CONFIG_THERMAL_WRITABLE_TRIPS=n
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=n
CONFIG_THERMAL_EMULATION=n

# Disable CPU Idle states that drop frequencies (optional but aggressive)
# CONFIG_CPU_IDLE is not set
# CONFIG_ARM_CPUIDLE is not set
