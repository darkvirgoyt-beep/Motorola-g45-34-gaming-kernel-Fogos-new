###############################################################################
# FogOS Extreme Gaming Kernel - Gaming Optimization Fragment
# Device: Motorola G45 (SM6375 / Holi)
# Developer: Prince (VirgoYT707)
# Kernel Base: 5.4.302
# Purpose: Maximum BGMI gaming performance with lowest possible latency
###############################################################################

###############################################################################
# BRANDING
###############################################################################
CONFIG_LOCALVERSION="-G45-Gaming"

###############################################################################
# FOGOS CONTROLLER LINK
# Built-in profile endpoint used by the signed FogOS PulseControl app and the
# trusted Magisk/system profile bridge. The driver accepts only balanced,
# performance, and extreme_gaming; it does not expose arbitrary sysfs writes.
###############################################################################
CONFIG_FOGOS_PROFILE=y

###############################################################################
# KERNEL IMAGE FORMAT
# The Moto G45 / G34 bootloader expects a raw uncompressed ARM64 Image.
# Do NOT use Image.gz, Image.lz4, or Image.lzma — the stock bootloader
# cannot decompress these and will bootloop. The partition size is 96 MiB
# (boot_a/boot_b). The kernel + ramdisk + AVB metadata must fit within it.
# We keep techpack/camera and techpack/audio OUT of the boot Image (they
# ship as vendor_dlkm .ko modules in stock), which keeps the Image below
# the partition limit.
###############################################################################
CONFIG_BUILD_ARM64_UNCOMPRESSED_KERNEL=y
# CONFIG_BUILD_ARM64_KERNEL_COMPRESSION_GZIP is not set

###############################################################################
# CPU - Performance Scheduler & Boost
###############################################################################

# Full preemption for lowest latency
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT=y

# WALT scheduler (already present, ensure tuning options are on)
CONFIG_SCHED_WALT=y
CONFIG_SCHED_CASS=y

# schedutil governor (adaptive, works well with WALT)
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y

# Default to performance governor for maximum gaming throughput
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

# uclamp task clamping for foreground boost
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=20

# High resolution timers (lower latency wakeup)
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ=y

# IRQ time accounting
CONFIG_IRQ_TIME_ACCOUNTING=y

# SMP nice spreading for gaming (use big cores)
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y

# 300 Hz timer tick — sweet spot for gaming latency without battery kill
CONFIG_HZ_300=y
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set

###############################################################################
# GPU - Adreno Performance
###############################################################################

# Adreno GPU devfreq governors
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y
CONFIG_QCOM_KGSL=y
CONFIG_QCOM_KGSL_CONTEXT_DEBUG=y

###############################################################################
# VIDEO HARDWARE DECODE
# Venus conflicts with techpack/video/msm/vidc (both built on Holi).
# Keep CONFIG_VIDEO_QCOM_VENUS off — techpack/video provides the hardware
# decoder. Required media framework plumbing for camera preview / recordings.
###############################################################################
# CONFIG_VIDEO_QCOM_VENUS is not set
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_V4L2=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_VIDEOBUF2_V4L2=y

# HDCP — required for Widevine L1 (HD Netflix, Amazon Prime, Hotstar)
CONFIG_HDCP_QSEECOM=y

###############################################################################
# MEMORY - LMK & VM Optimization
###############################################################################

# LRU_GEN for better memory reclaim (modern MGLRU)
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Android LMKD support
CONFIG_ANDROID_LOW_MEMORY_KILLER=y

# Balance anonymous vs file page reclaim
CONFIG_BALANCE_ANON_FILE_RECLAIM=y

# Prioritize OOM tasks
CONFIG_PRIORITIZE_OOM_TASKS=y

# ZRAM with ZSTD (fastest + best ratio for gaming)
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_ZSMALLOC_STAT=y

# CMA for contiguous memory allocation
CONFIG_CMA=y

# Transparent huge pages for better memory throughput
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set

# Reduce memory fragmentation
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y

# Faster memory allocation path
CONFIG_SLUB=y
CONFIG_SLUB_CPU_PARTIAL=y

###############################################################################
# I/O SCHEDULER - BFQ Tuned for Low Latency
###############################################################################

CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_DEFAULT_IOSCHED="bfq"
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y

# UFS (storage) optimizations
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFSHCD_QTI=y

# Block layer tuning
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BLK_WBT=y

###############################################################################
# NETWORK - Low Latency TCP
###############################################################################

# TCP BBR congestion control (best for gaming/low latency)
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# UDP busy-poll for low-latency game socket wakeup
CONFIG_NET_RX_BUSY_POLL=y

###############################################################################
# SCREEN RECORDING — SW_SYNC fence driver
# Required for Android screenrecord / media projection to work.
# Without this the buffer synchronisation fence is missing and recording
# either fails silently or produces a blank/green video.
###############################################################################
CONFIG_SW_SYNC=y
CONFIG_SYNC_FILE=y

###############################################################################
# AUDIO — Preserve stock Motorola/Holi QDSP6 techpack stack for Dolby stability
#
# Root cause of Dolby Atmos crash: the generic in-tree SND_SOC_QCOM machine
# driver and vendor techpack/audio AUDIO_QGKI both register the same QDSP6
# ASoC machine. When both are compiled in, audioserver enumerates duplicate
# sound cards, the Dolby effect plugin binds to the wrong one, and crashes
# repeatedly.
#
# Fix: keep SND_SOC_QCOM disabled. Let techpack/audio AUDIO_QGKI own the
# QDSP6 machine driver exclusively (it is excluded from the boot Image as a
# vendor_dlkm .ko which the stock vendor_dlkm.img already has).
# Only keep the in-tree SLIMBUS and codec support that does NOT conflict.
###############################################################################
# CONFIG_SND_SOC_QCOM is not set
CONFIG_AUDIO_QGKI=y
CONFIG_QTI_PP=y
CONFIG_SND_HWDEP_ROUTING=y
CONFIG_MFD_WCD=y
CONFIG_REGMAP_WCD_IRQ=y
CONFIG_SND_SOC_FS1815=y

# SLIMBUS: NGD (New Generation Driver) for Holi — MSM_CTRL disabled because
# it pulls in the missing qdsp6v2/apr.h header from techpack/audio
CONFIG_SLIMBUS=y
CONFIG_SLIMBUS_MSM_NGD=y
# CONFIG_SLIMBUS_MSM_CTRL is not set

# Enable audio compress offload for hardware decode (QDSP6 DSP offload path)
CONFIG_SND_COMPRESS_OFFLOAD=y
CONFIG_SND_SOC_COMPRESS=y

###############################################################################
# DRM / DISPLAY — prevent in-tree MSM DRM from double-building
# techpack/display uses its own DRM implementation. If in-tree drivers/gpu/drm/msm/
# is also compiled (CONFIG_DRM_MSM=y), both trees export the same symbols
# → duplicate-symbol link error. Keep in-tree MSM DRM off.
###############################################################################
# CONFIG_DRM_MSM is not set

###############################################################################
# PERFORMANCE EXTRAS
###############################################################################

# RT group scheduling for SurfaceFlinger/compositor RT threads
CONFIG_RT_GROUP_SCHED=y

# Thermal trip point userspace control (for runtime trip point tuning)
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_THERMAL_GOV_USER_SPACE=y

# Inline optimization
CONFIG_INLINE_OPTIMIZATION=y

# Fast no-HZ RCU
CONFIG_RCU_FAST_NO_HZ=y
