###############################################################################
# FogOS runtime profile fragment — Motorola G45/G34 (fogos)
#
# Customization:
# 1. Performance Profile: Max Uncapped Overclock (WALT / Schedutil / GPU Burst / Kyber I/O)
# 2. Security: Rootless / CTS Clean (SELinux Enforcing, Play Integrity Verified)
# 3. Memory & Swapping: Zstandard (ZSTD) Adaptive 4GB/8GB Compression
###############################################################################

# Core FogOS runtime profile driver
CONFIG_FOGOS_PROFILE=y

# ── Max Uncapped Performance & Governor Tuning ──
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_SCHED_WALT=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y

# ── Low-Latency Gaming TCP / Networking ──
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBRPLUS=y
CONFIG_DEFAULT_BBRPLUS=y
CONFIG_DEFAULT_TCP_CONG="bbrplus"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y

# ── Zstandard (ZSTD) Adaptive RAM Compression ──
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_DEFLATE=y

# ── CTS Clean / Google Play Integrity & Enforcing Security ──
# KernelSU is disabled to maintain strict CTS / Play Integrity passing
# and vendor_dlkm ABI binary compatibility.
# CONFIG_KSU is not set
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
