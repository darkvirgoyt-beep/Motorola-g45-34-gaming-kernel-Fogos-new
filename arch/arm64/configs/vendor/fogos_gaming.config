###############################################################################
# FogOS runtime profile fragment — Motorola G45/G34 (fogos)
#
# Compatibility rule: FogOS starts from the exact extracted Evolution X Android
# 17 stock configuration. Performance, balanced, and extreme gaming behavior is
# applied at runtime through /dev/fogos_profile by the trusted profile service.
# Do not add driver, module-mode, LOCALVERSION, CFI, KALLSYMS, or ABI-related
# options here; matching vendor_dlkm modules provide camera, audio/Dolby,
# charging, touch, radio, sensors, and Wi-Fi.
###############################################################################

# The only built-in FogOS kernel addition. The userspace controller may select
# balanced, performance, or extreme_gaming; it cannot make arbitrary sysfs
# changes itself.
CONFIG_FOGOS_PROFILE=y

# Pacing-aware TCP defaults for cellular/Wi-Fi Internet workloads. BBRplus is
# congestion control, not a radio-speed or FPS unlock; fq is required for its
# pacing model to be used by the networking stack.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBRPLUS=y
CONFIG_DEFAULT_BBRPLUS=y
CONFIG_DEFAULT_TCP_CONG="bbrplus"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y

# KernelSU is not part of the known-good Evolution X stock kernel and its
# core hooks can change kernel/module symbol CRCs. Rootless PulseControl does
# not need it, so keep it disabled for vendor_dlkm ABI compatibility.
# CONFIG_KSU is not set
