###############################################################################
# FogOS Extreme Gaming Kernel - Gaming Optimization Fragment
# Device: Motorola G45 (SM6375 / Holi)
# Developer: Prince (VirgoYT707)
# Kernel Base: 5.4.302
# Purpose: Maximum BGMI gaming performance with lowest possible latency
###############################################################################

###############################################################################
# BRANDING
###############################################################################
CONFIG_LOCALVERSION="-FogOS-Extreme-Gaming-v1.0"

###############################################################################
# CPU - Performance Scheduler & Boost
###############################################################################

# Full preemption for lowest latency
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT=y

# WALT scheduler (already present, ensure tuning options are on)
CONFIG_SCHED_WALT=y
CONFIG_SCHED_CASS=y

# schedutil governor (adaptive, works well with WALT)
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y

# uclamp task clamping for foreground boost
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=20

# High resolution timers (lower latency wakeup)
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ=y

# IRQ time accounting
CONFIG_IRQ_TIME_ACCOUNTING=y

# SMP nice spreading for gaming (use big cores)
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y

# Reduce scheduling jitter
CONFIG_HZ_300=y
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set

###############################################################################
# GPU - Adreno Performance
###############################################################################

# Adreno GPU devfreq governors
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y
CONFIG_QCOM_KGSL=y
CONFIG_QCOM_KGSL_CONTEXT_DEBUG=y

###############################################################################
# MEMORY - LMK & VM Optimization
###############################################################################

# LRU_GEN for better memory reclaim (modern MGLRU)
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Android LMKD support
CONFIG_ANDROID_LOW_MEMORY_KILLER=y

# Balance anonymous vs file page reclaim
CONFIG_BALANCE_ANON_FILE_RECLAIM=y

# Prioritize OOM tasks
CONFIG_PRIORITIZE_OOM_TASKS=y

# ZRAM with ZSTD (fastest + best ratio for gaming)
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_ZSMALLOC_STAT=y

# CMA for contiguous memory allocation
CONFIG_CMA=y

# Transparent huge pages for better memory throughput
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set

# Reduce memory fragmentation
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y

# Faster memory allocation path
CONFIG_SLUB=y
CONFIG_SLUB_CPU_PARTIAL=y

###############################################################################
# I/O SCHEDULER - BFQ Tuned for Low Latency
###############################################################################

CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_DEFAULT_IOSCHED="bfq"
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y

# UFS (storage) optimizations
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFSHCD_QTI=y

# Block layer tuning
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BLK_WBT=y

###############################################################################
# NETWORK - Low Latency TCP
###############################################################################

# TCP BBR congestion control (best for gaming/low latency)
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Additional TCP algorithms
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BIC=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_TCP_CONG_VENO=y
CONFIG_TCP_CONG_ILLINOIS=y

# FQ packet scheduler (required for BBR to work properly)
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# Netfilter optimizations
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XT_TARGET_DSCP=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NET_SCHED=y

###############################################################################
# TOUCH - Maximum Sampling Rate
###############################################################################

CONFIG_INPUT_TOUCHSCREEN=y
# Touchscreen drivers (already in base config)

###############################################################################
# FILESYSTEM - Performance
###############################################################################

# EXT4 with optimizations
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y

# F2FS for fast flash storage
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y

# FUSE (Android overlay filesystems)
CONFIG_FUSE_FS=y

# EROFS (Android read-only compressed fs)
CONFIG_EROFS_FS=y

# ExFAT support
CONFIG_EXFAT_FS=y

# Faster filesystem cache
CONFIG_DCACHE_WORD_ACCESS=y

###############################################################################
# LOGGING - Disable Debug Overhead
###############################################################################

# Disable trace printk overhead
CONFIG_DISABLE_TRACE_PRINTK=y

# Disable debug preempt
# CONFIG_DEBUG_PREEMPT is not set

# Disable lock stat (overhead)
# CONFIG_LOCK_STAT is not set

# Disable lock debugging
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_RWSEMS is not set

# Disable slab debugging
# CONFIG_SLUB_DEBUG is not set

# Disable memory debugging
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_DEBUG_VM is not set

# Disable stack debugging  
# CONFIG_DEBUG_STACK_USAGE is not set

# Keep bug checking but disable verbose
# CONFIG_BUG_ON_DATA_CORRUPTION is not set

###############################################################################
# SECURITY - Keep Compatible
###############################################################################

# SELinux enforcing (banking app compatibility)
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# Android security
CONFIG_ANDROID_PARANOID_NETWORK=y

###############################################################################
# PERFORMANCE - General
###############################################################################

# Inline optimization
CONFIG_INLINE_OPTIMIZATION=y

# LLVM Polly loop optimizer (if available with clang)
CONFIG_LLVM_POLLY=y

# LTO (Link Time Optimization) for smaller/faster binary
CONFIG_LTO_CLANG=y

# Adaptive tolerance
CONFIG_ADAPTIVE_TOLERANCE_OPTIMIZATION=y

# RCU optimizations
CONFIG_RCU_EXPERT=y
CONFIG_RCU_FAST_NO_HZ=y
CONFIG_RCU_NOCB_CPU=y

# Suspend optimization
CONFIG_SUSPEND_SKIP_SYNC=y

# WireGuard VPN (fast in-kernel)
CONFIG_WIREGUARD=y

# 8 CPUs (SM6375 is octa-core)
CONFIG_NR_CPUS=8

# ZRAM size override (3x RAM for gaming)
CONFIG_ZRAM_SIZE_OVERRIDE=3

# Modules support
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

###############################################################################
# CGROUP - Android gaming
###############################################################################

CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y
CONFIG_UCLAMP_TASK_GROUP=y

###############################################################################
# INTERCONNECT - Holi Platform
###############################################################################

CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_HOLI=y
CONFIG_INTERCONNECT_QCOM_CPUCP_L3=y
CONFIG_INTERCONNECT_QCOM_RPM=y
CONFIG_INTERCONNECT_QCOM_QOS=y
